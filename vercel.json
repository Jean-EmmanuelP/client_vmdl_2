{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NODE_VERSION": "22.x"
  },
  "crons": [
    {
      "path": "/api/cron/generate-article",
      "schedule": "0 8 */2 * *"
    }
  ],
  "functions": {
    "src/app/api/cron/generate-article/route.ts": {
      "maxDuration": 60
    }
  }
}
